{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flutter Web",
			"type": "shell",
			"command": "C:\\flutter\\bin\\flutter.bat",
			"args": [
				"run",
				"-d",
				"web-server",
				"--web-hostname",
				"127.0.0.1",
				"--web-port",
				"8080"
			],
			"options": {
				"cwd": "${workspaceFolder}\\peso_application"
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}